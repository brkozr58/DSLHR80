       sum( payroll.betrg10  ) as bet10,
       sum( payroll.betrg11  ) as bet11,
       sum( payroll.betrg12  ) as bet12,
       //
       pa1_begda,
       pa1_endda,
       payroll.bukrs,
       bukrs_t,
       orgeh,
       orgeh_t,
       plans,
       plans_t,
       stell,
       stell_t,
       kokrs,
       kokrs_t,
       kostl,
       kostl_t,
       werks,
       werks_t,
       werks_new,
       btrtl,

define view /DSL/HR80_CDS005
  as select from /dsl/hr80_ddl004 as payroll
{

  key  payroll.molga,
  key  gjahr,
  key  payroll.grpid,
  key  payroll.vrsid,
  key  rfper,
  key  pernr,
  key  ztabl,
  key  payroll.lgart,
       //
       ename,
       lgtxt,
       momag,
       payroll.ktopl,
       //
       sum( payroll.betrg01  ) as bet01,
       sum( payroll.betrg02  ) as bet02,
       sum( payroll.betrg03  ) as bet03,
       sum( payroll.betrg04  ) as bet04,
       sum( payroll.betrg05  ) as bet05,
       sum( payroll.betrg06  ) as bet06,

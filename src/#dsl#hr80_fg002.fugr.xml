      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Dieser Funktionsbaustein erlaubt, die Abrechnung zu starten und das</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Ergebnis (Cluster im PCLx-Puffer) zu erhalten.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Als Input wird eine Liste von Personalnummern erwartet</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>(EMPLOYEE_NUMBERS). Für jede darin enthaltene Personalnummer wird im</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Feld EMPLOYEE_NUMBERS-RETCD festgehalten, ob die Abrechnung für diese</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Personalnummer erfolgreich war:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>EMPLOYEE_NUMBERS-RETCD = 0: Die Abrechnung war erfolgreich</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>B1</TDFORMAT>
       <TDLINE>EMPLOYEE_NUMBERS-RETCD &gt; 0: Die Abrechnung war nicht erfolgreich.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Zum Starten der Abrechnung wird eine Selektionsvariante benötigt.</TDLINE>
